                                            <li><a href="@Url.Action("Index", "Knowledge")">知識庫下載</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="@Url.Action("Index", "Calender")" class="dropdown-toggle" data-toggle="dropdown" title="行事曆">行事曆 <i class="fa fa-angle-down"></i></a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a href="@Url.Action("Index", "Calender")">協會行事曆</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="@Url.Action("Index", "Contact")" class="dropdown-toggle" data-toggle="dropdown" title="聯絡我們">聯絡我們 <i class="fa fa-angle-down"></i></a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a href="@Url.Action("Index", "Contact")">聯絡我們</a></li>
                                        </ul>
                                    </li>
                                </ul><!--/ Nav ul end -->

                            </div><!--/ Collapse end -->

