
@model MvcPaging.IPagedList<IAAI_TW_01.Models.Knowlodge>
@using MvcPaging


@{
    ViewBag.Title = "Index";
}

<h2>知識庫</h2>
<h3>知識庫</h3>


@{ var controllerName = ViewContext.RouteData.Values["controller"].ToString();}


<p>
    @Html.ActionLink("按我新增", "Create")
</p>

<div class="content-box-large">
    <div class="panel-heading">
        <h4>列表</h4>
    </div>
    <div class="panel-body">
        <div id="example_wrapper" class="dataTables_wrapper form-inline" role="grid">

            <div class="row">
                @*row counts*@
                <div class="col-xs-6">
                    <div id="example_length" class="dataTables_length">
                        <label>
                            <select size="1" name="example_length" aria-controls="example">
                                <option value="10" selected="selected">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                            records per page
                        </label>
                    </div>
                </div>
            </div>



            <table cellpadding="0" cellspacing="0" border="0" class="table table-striped table-bordered dataTable" id="example" aria-describedby="example_info">
                <thead>
                    <tr role="row">
                        <th class="sorting_asc" role="columnheader" tabindex="0" aria-controls="example" rowspan="1" colspan="1" aria-sort="ascending" aria-label="Rendering engine: activate to sort column descending" style="width: 215.778px;">@Html.DisplayNameFor(Model => Model.FirstOrDefault().Title)</th>
                        <th class="sorting" role="columnheader" tabindex="0" aria-controls="example" rowspan="1" colspan="1" aria-label="CSS grade: activate to sort column ascending">@Html.DisplayNameFor(Model => Model.FirstOrDefault().FileName)</th>
                        <th class="sorting" role="columnheader" tabindex="0" aria-controls="example" rowspan="1" colspan="1" aria-label="CSS grade: activate to sort column ascending">@Html.DisplayNameFor(Model => Model.FirstOrDefault().CreateAt)</th>
                        <th class="sorting" role="columnheader" tabindex="0" aria-controls="example" rowspan="1" colspan="1" aria-label="CSS grade: activate to sort column ascending">@Html.DisplayNameFor(Model => Model.FirstOrDefault().UpdateAt)</th>
                        <th class="sorting" role="columnheader" tabindex="0" aria-controls="example" rowspan="1" colspan="1" style="width:200px"></th>
                    </tr>
                </thead>

                <tbody role="alert" aria-live="polite" aria-relevant="all">
                    @{
                        int rowCnt = 0;
                        foreach (var item in Model)
                        {
                            rowCnt++;
                            if (rowCnt % 2 == 1)
                            {
                                //奇數行
                                <tr class="gradeA odd">
                                    <td class="  sorting_1">@item.Title</td>
                                    <td class=" ">
                                        <a href="@item.FilePath" download="@item.FileName">@item.FileName</a>
                                    </td>
                                    <td class=" ">@item.CreateAt</td>
                                    <td class=" ">@item.UpdateAt</td>
                                    <td>
                                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                                        @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                                        @using (Html.BeginForm("Delete", controllerName, new { id = item.Id }, FormMethod.Post, new { @class = "", enctype = "multipart/form-data", style = "display:inline;", onclick = "return confirm('Are you sure you want to delete this item?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="submit" value="Delete" class="btn btn-delelete" />
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                //偶數行
                                <tr class="gradeA even">
                                    <td class="  sorting_1">@item.Title</td>
                                    <td class=" ">
                                        <a href="@item.FilePath" download="@item.FileName">@item.FileName</a>
                                    </td>
                                    <td class=" ">@item.CreateAt</td>
                                    <td class=" ">@item.UpdateAt</td>
                                    <td>
                                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                                        @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                                        @using (Html.BeginForm("Delete", controllerName, new { id = item.Id }, FormMethod.Post, new { @class = "", enctype = "multipart/form-data", style = "display:inline;", onclick = "return confirm('Are you sure you want to delete this item?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="submit" value="Delete" class="btn btn-delelete" />
                                        }
                                    </td>
                                </tr>

                            }
                        }
                    }
                </tbody>
            </table>
            <!--分頁開始-->
            <div class="pager">
                <div class="pages">
                    <div class="pagination">
                        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount)

                    </div>
                    <div class="page_boxR"> 資料筆數：@ViewBag.count  　</div>
                </div>
            </div>
            <!--分頁結束-->
        </div>
    </div>
</div>
