@model IAAI_TW_01.Models.Knowlodge

@{
    ViewBag.Title = "Delete";
}

<h2>知識庫</h2>
<h3>知識庫</h3>

<div class="content-box-large">
    <div class="panel-heading">
        <h4>刪除項目</h4>
    </div>
    <h4>Are you sure you want to delete this?</h4>
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.Title)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.FileName, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-md-10">
                <span class="form-control">
                    <a href="@Html.DisplayFor(Model => Model.FilePath)" download="@Html.DisplayFor(Model => Model.FileName)">@Html.DisplayFor(Model => Model.FileName)</a>
                </span>

            </div>
        </div>


        <div class="form-group">
            @Html.LabelFor(model => model.CreateAt, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.UpdateAt)</span>
            </div>
        </div>



        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Delete" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this item?');" /> |
                @Html.ActionLink("Back to List", "Index")
            </div>
        }
    </div>

</div>