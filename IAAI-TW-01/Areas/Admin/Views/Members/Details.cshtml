@model IAAI_TW_01.Models.Member

@{
    ViewBag.Title = "Details";
}

<h2>會員管理</h2>
<h3>會員管理</h3>

<div class="content-box-large">
    <div class="panel-heading">
        <h4>詳細內容</h4>
    </div>
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.Account, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.DisplayFor(model => model.Account)</div>
            </div>
        </div>

        <hr />
        <div class="panel-heading">
            <h4>個人資訊</h4>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MemberInfos.FirstOrDefault().Name, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().Name)</div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MemberInfos.FirstOrDefault().Gender, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().Gender)</div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MemberInfos.FirstOrDefault().Birth, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().Birth)</div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MemberInfos.FirstOrDefault().MemberType, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().MemberType)</div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MemberInfos.FirstOrDefault().ContactAddress, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().ContactAddress)</div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MemberInfos.FirstOrDefault().Email, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().Email)</div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MemberInfos.FirstOrDefault().IsInternationalMember, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().IsInternationalMember)</div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MemberInfos.FirstOrDefault().ServiceAt, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().ServiceAt)</div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MemberInfos.FirstOrDefault().PositionName, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().PositionName)</div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MemberInfos.FirstOrDefault().TopLevelEducation, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().TopLevelEducation)</div>
            </div>
        </div>

        <hr />
        <div class="panel-heading">
            <h4>服務經歷</h4>
        </div>

        @{
            foreach (var item in Model.MemberServices)
            {
                <div class="form-group">
                    @Html.LabelFor(model => model.MemberServices.FirstOrDefault().ServiceAt, htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-10">
                        <div class="">@Html.Raw(Model.MemberServices.FirstOrDefault().ServiceAt)</div>
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.MemberServices.FirstOrDefault().PositionName, htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-10">
                        <div class="">@Html.Raw(Model.MemberServices.FirstOrDefault().PositionName)</div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2 control-label">服務期間: </label>
                    <div class="col-sm-10">
                        <div class="">@Html.Raw(Model.MemberServices.FirstOrDefault().ServicedTimeStartYear) 年/ @Html.Raw(Model.MemberServices.FirstOrDefault().ServicedTimeStartMonth) 月 ~ @Html.Raw(Model.MemberServices.FirstOrDefault().ServicedTimeEndYear) 年/ @Html.Raw(Model.MemberServices.FirstOrDefault().ServicedTimeEndMonth) 月</div>
                    </div>
                </div>
            }
        }

        <div class="form-group">
            <label class="col-sm-2 control-label">相關年資合計： </label>
            <div class="col-sm-10">
                <div class="">@Html.Raw(Model.MemberInfos.FirstOrDefault().RelativeServicedTimeYear) 年/ @Html.Raw(Model.MemberInfos.FirstOrDefault().RelativeServicedTimeMonth) 月 </div>
            </div>
        </div>




    </div>

    <p>
        @Html.ActionLink("Back to List", "Index")
    </p>
</div>