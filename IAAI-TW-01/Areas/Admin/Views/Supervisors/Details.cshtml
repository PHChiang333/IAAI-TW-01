@model IAAI_TW_01.Models.Supervisor

@{
    ViewBag.Title = "Details";
}

<h2>關於我們</h2>
<h3>協會介紹 - 理監事</h3>

<div class="content-box-large">
    <div class="panel-heading">
        <h4>詳細內容</h4>
    </div>
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.PositionName, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.PositionName)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.Name)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Gender, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.Gender)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ServiceHistory, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.ServiceHistory)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Term, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.Term)</span>
            </div>
        </div>


        <div class="form-group">
            @Html.LabelFor(model => model.CreateAt, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.UpdateAt)</span>
            </div>
        </div>

    </div>


    <p>
        @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
        @Html.ActionLink("Back to List", "Index")
    </p>
</div>