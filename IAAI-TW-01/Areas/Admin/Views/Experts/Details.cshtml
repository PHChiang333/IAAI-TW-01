@model IAAI_TW_01.Models.Expert

@{
    ViewBag.Title = "Details";
}

<h2>關於我們</h2>
<h3>專家介紹</h3>

<div class="content-box-large">
    <div class="panel-heading">
        <h4>詳細內容</h4>
    </div>
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.Name)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ServiceAt, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.ServiceAt)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ServiceAt, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-md-10">
                <img id="existedCover" src="@Html.DisplayFor(model => model.CoverPath)" alt="CoverExisted" style="max-width: 100px; max-height:100px" />
            </div>
        </div>


        <div class="form-group">
            @Html.LabelFor(model => model.History, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <div class="showCke">@Html.Raw(Model.History)</div>
            </div>
        </div>


        <div class="form-group">
            @Html.LabelFor(model => model.CreateAt, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.UpdateAt)</span>
            </div>
        </div>

    </div>

    <p>
        @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
        @Html.ActionLink("Back to List", "Index")
    </p>
</div>


