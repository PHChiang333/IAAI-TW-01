@model IAAI_TW_01.Areas.Admin.Data.ExpertCreateDto

@{
    ViewBag.Title = "Create";
}

<h2>關於我們</h2>
<h3>專家介紹</h3>

<div class="content-box-large">
    <div class="panel-heading">
        <h4>新增項目</h4>
    </div>

    @using (Html.BeginForm("Create","Experts",FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group">
                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.ServiceAt, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.ServiceAt, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.ServiceAt, "", new { @class = "text-danger" })
                </div>
            </div>

            @*cover upload*@
            <div class="form-group">
                @Html.LabelFor(model => model.CoverPath, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <label for="file">選擇照片：</label>
                    @*@Html.EditorFor(model => model.CoverPath, new { htmlAttributes = new { @class = "form-control" } })*@
                    <input type="file" name="CoverFile" id="coverInput" accept="image/*" />
                    <img id="previewCover" src="#" alt="Cover預覽" style="max-width: 300px; display: none;" />
                    <p class="@ViewBag.textDanger">@ViewBag.ErrorFile</p>
                </div>
            </div>


            <hr />
            <div class="form-group">
                <div class="control-label col-md-2">
                    <h5>詳細資料</h5>
                </div>
            </div>


            <div class="form-group">
                @Html.LabelFor(model => model.History, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <textarea name="History" id="editor1" rows="5" cols="80" class="form-control">
                    </textarea>
                    @Html.ValidationMessageFor(model => model.History, "", new { @class = "text-danger" })
                </div>
            </div>


            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Create" class="btn btn-default" />
                </div>
            </div>
        </div>
    }

    <div>
        @Html.ActionLink("Back to List", "Index")
    </div>
</div>



@section Scripts {
    @*CKE*@
    <script>
        $(function () {
            if (typeof CKEDITOR !== 'undefined') {
                CKEDITOR.replace('editor1', {
                    toolbar: [
                        { name: 'document', items: ['Source', '-', 'Save', 'NewPage', 'Preview', 'Print', '-', 'Templates'] },
                        { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'] },
                        { name: 'editing', items: ['Find', 'Replace', '-', 'SelectAll', '-', 'Scayt'] },
                        { name: 'forms', items: ['Form', 'Checkbox', 'Radio', 'TextField', 'Textarea', 'Select', 'Button', 'ImageButton', 'HiddenField'] },
                        '/',
                        { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'RemoveFormat'] },
                        {
                            name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', 'CreateDiv',
                                '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock', '-', 'BidiLtr', 'BidiRtl', 'Language']
                        },
                        { name: 'links', items: ['Link', 'Unlink', 'Anchor'] },
                        { name: 'insert', items: ['Image', 'Flash', 'Table', 'HorizontalRule', 'Smiley', 'SpecialChar', 'PageBreak', 'Iframe'] },
                        '/',
                        { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                        { name: 'colors', items: ['TextColor', 'BGColor'] },
                        { name: 'tools', items: ['Maximize', 'ShowBlocks'] },
                        { name: 'about', items: ['About'] }
                    ],
                    extraPlugins: 'colorbutton,colordialog,font',
                    removeButtons: ''
                });
            } else {
                console.error("CKEditor not loaded");
            }
        });
    </script>
    @*預覽Cover*@
    <script>
        document.getElementById("coverInput").addEventListener("change", function (event) {
            var file = event.target.files[0];

            if (file && file.type.startsWith("image/")) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    var preview = document.getElementById("previewCover");
                    preview.src = e.target.result;
                    preview.style.display = "block";
                };

                reader.readAsDataURL(file);
            } else {
                alert("請選擇圖片格式檔案");
            }
        });
    </script>
}