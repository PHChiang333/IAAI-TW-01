@model IAAI_TW_01.Models.News

@{
    ViewBag.Title = "Details";
}

<h2>最新消息</h2>
<h3>最新消息</h3>

<div class="content-box-large">
    <div class="panel-heading">
        <h4>詳細內容</h4>
    </div>
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.Title)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Content, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                @*<span class="form-control">@Html.DisplayFor(model => model.Content)</span>*@
                <div class="showCke">@Html.Raw(Model.Content)</div>
            </div>
        </div>


        <div class="form-group">
            @Html.LabelFor(model => model.CoverPath, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <img id="existedCover" src="@Html.DisplayFor(model => model.CoverPath)" alt="@Html.DisplayFor(model => model.CoverName)" style="max-width: 100px; max-height:100px" />
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.CreateAt, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.UpdateAt)</span>
            </div>
        </div>

    </div>

    <p>
        @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
        @Html.ActionLink("Back to List", "Index")
    </p>
</div>
