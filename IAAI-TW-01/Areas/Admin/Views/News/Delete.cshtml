@model IAAI_TW_01.Models.News

@{
    ViewBag.Title = "Delete";
}

<h2>最新消息</h2>
<h3>最新消息</h3>

<div class="content-box-large">
    <div class="panel-heading">
        <h4>刪除項目</h4>
    </div>
    <h4>Are you sure you want to delete this?</h4>
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.Title)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Content, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.Content)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.CoverName, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.CoverName)</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.CoverPath, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.CoverPath)</span>
            </div>
        </div>


        <div class="form-group">
            @Html.LabelFor(model => model.CreateAt, htmlAttributes: new { @class = "col-sm-2 control-label" })
            <div class="col-sm-10">
                <span class="form-control">@Html.DisplayFor(model => model.UpdateAt)</span>
            </div>
        </div>



        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Delete" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this item?');" /> |
                @Html.ActionLink("Back to List", "Index")
            </div>
        }
    </div>

</div>